@using System.Globalization
@page "/budgets"
@implements IDisposable
@inject PeriodState PeriodState
@inject ILedgerLiteApiClient Api
@inject IToastService Toast

<PageTitle>Budgets · LedgerLite</PageTitle>

<div class="flex flex-col gap-6">
    <header class="flex flex-wrap items-center justify-between gap-4 animate-rise">
        <div>
            <h1 class="font-display text-2xl font-semibold text-slate-100">Budgets</h1>
            <p class="mt-1 text-sm text-slate-500">@(PeriodState.CurrentPeriod is { } p ? $"Spending limits · {p.Name}" : "Spending limits")</p>
        </div>
        <div class="flex gap-2">
            <Button Variant="ButtonVariant.Secondary" Disabled="PeriodState.CurrentPeriod is null || _budgetRows.Count == 0" Loading="_reevaluating" OnClick="ReevaluateAsync">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 12a9 9 0 1 1-9-9" />
                    <path d="M21 3v9h-9" />
                </svg>
                Re-evaluate
            </Button>
            <Button Variant="ButtonVariant.Primary" Disabled="PeriodState.CurrentPeriod is null" OnClick="OpenCreateModalAsync">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14" />
                    <path d="M12 5v14" />
                </svg>
                Set budget
            </Button>
        </div>
    </header>

    @if (PeriodState.CurrentPeriod is null)
    {
        <Card Class="animate-rise" Style="animation-delay:50ms">
            <EmptyState Title="Select a period first"
                        Hint="Budgets belong to a fiscal period — pick one in the topbar, or create a new period.">
                <ActionFragment>
                    <a href="/periods"
                       class="text-xs font-medium text-accent-400 outline-none transition-colors hover:text-accent-300">Go to fiscal periods &rarr;</a>
                </ActionFragment>
            </EmptyState>
        </Card>
    }
    else if (_isLoading)
    {
        <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
            @for (int index = 0; index < 3; index++)
            {
                <div @key="index" class="card-surface flex flex-col gap-4 p-5">
                    <Skeleton Class="h-4 w-28" />
                    <Skeleton Class="h-2 w-full" />
                    <Skeleton Class="h-3 w-20" />
                </div>
            }
        </div>
    }
    else if (_error is not null)
    {
        <ErrorPanel Message="@_error" Retry="LoadBudgetsAsync" />
    }
    else if (_budgetRows.Count == 0)
    {
        <Card Class="animate-rise" Style="animation-delay:50ms">
            <EmptyState Title="No budgets set"
                        Hint="Pick an expense category and a limit — you'll get alerts at 80% and 100%.">
                <ActionFragment>
                    <Button Variant="ButtonVariant.Primary" OnClick="OpenCreateModalAsync">Set the first budget</Button>
                </ActionFragment>
            </EmptyState>
        </Card>
    }
    else
    {
        <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
            @foreach (BudgetRow row in _budgetRows)
            {
                <div @key="row.Budget.Id"
                     class="card-surface flex flex-col gap-4 p-5 transition-all duration-200 animate-rise hover:border-white/[0.14]">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <p class="truncate font-display text-lg font-semibold text-slate-100">@row.Budget.Category</p>
                            <p class="mt-0.5 font-mono text-xs text-slate-500 tnum">@row.Budget.Currency</p>
                        </div>
                        @if (row.Evaluation is { } evaluation && evaluation.ThresholdsExceeded.Count > 0)
                        {
                            <div class="flex flex-wrap justify-end gap-1.5">
                                @foreach (BudgetThreshold threshold in evaluation.ThresholdsExceeded.Where(t => t is not BudgetThreshold.None))
                                {
                                    <Badge Tone="@ThresholdTone(threshold)">@(threshold is BudgetThreshold.HundredPercent ? "Limit reached" : "80% used")</Badge>
                                }
                            </div>
                        }
                        else
                        {
                            <Badge Tone="BadgeTone.Emerald">Healthy</Badge>
                        }
                    </div>
                    <BudgetBar Label="@row.Budget.Category"
                               Spent="row.Evaluation?.SpentAmount ?? 0"
                               Limit="row.Budget.LimitAmount" />
                </div>
            }
        </div>
    }
</div>

@* ---------- Set budget modal ---------- *@
<Modal @bind-IsOpen="_createOpen" Title="Set budget" Subtitle="One limit per expense category per period.">
    <ChildContent>
        <div class="flex flex-col gap-4">
        @if (_expenseAccounts.Count == 0)
        {
            <div class="flex items-start gap-3 rounded-xl border border-info-400/25 bg-info-400/[0.07] p-4">
                <svg class="mt-0.5 size-4 shrink-0 text-info-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" />
                    <path d="M12 16v-4" />
                    <path d="M12 8h.01" />
                </svg>
                <div>
                    <p class="text-sm font-medium text-slate-200">No expense accounts yet</p>
                    <p class="mt-1 text-sm leading-relaxed text-slate-400">
                        Budgets track expense categories. Create an expense account in this period first.
                    </p>
                    <a href="/accounts" class="mt-2 inline-block text-xs font-medium text-accent-400 outline-none transition-colors hover:text-accent-300">Go to accounts &rarr;</a>
                </div>
            </div>
        }
        else
        {
            <SelectField @bind-Value="_category" Label="Expense category" Placeholder="Select an expense account" Error="@_categoryError">
                @foreach (AccountResponse account in _expenseAccounts)
                {
                    <option value="@account.Name">@($"{account.Number} · {account.Name}")</option>
                }
            </SelectField>
            <Field @bind-Value="_limit" Label="Limit amount" Placeholder="500.00" Mono="true" InputMode="decimal" Error="@_limitError"
                   Hint="Thresholds alert at 80% and 100% of the limit." />
        }
        </div>
    </ChildContent>
    <FooterTemplate>
        <Button Variant="ButtonVariant.Secondary" OnClick="() => _createOpen = false">Cancel</Button>
        <Button Variant="ButtonVariant.Primary" Disabled="_expenseAccounts.Count == 0" Loading="_creating" OnClick="CreateAsync">Set budget</Button>
    </FooterTemplate>
</Modal>

@code {
    private IReadOnlyList<BudgetRow> _budgetRows = [];
    private bool _isLoading = true;
    private string? _error;
    private bool _reevaluating;

    private readonly List<AccountResponse> _expenseAccounts = [];
    private bool _accountsLoaded;
    private bool _createOpen;
    private bool _creating;
    private string _category = string.Empty;
    private string _limit = string.Empty;
    private string? _categoryError;
    private string? _limitError;

    protected override void OnInitialized() => PeriodState.Changed += OnPeriodChanged;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!PeriodState.IsLoaded)
            {
                await PeriodState.LoadAsync();
            }

            if (PeriodState.CurrentPeriod is not null)
            {
                await LoadBudgetsAsync();
            }
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _error = ex is ApiException api ? api.PrimaryError : "Could not reach the LedgerLite API. Make sure it is running.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadBudgetsAsync()
    {
        if (PeriodState.CurrentPeriod is null)
        {
            return;
        }

        _error = null;
        _isLoading = true;
        try
        {
            Guid periodId = PeriodState.CurrentPeriod.Id;
            IReadOnlyList<BudgetResponse> budgets = await Api.GetBudgetsAsync(periodId);
            IReadOnlyList<BudgetEvaluationResponse> evaluations = await Api.EvaluateBudgetsAsync(periodId);
            _budgetRows = [.. budgets
                .Select(budget => new BudgetRow(budget, evaluations.FirstOrDefault(evaluation => evaluation.BudgetId == budget.Id)))];
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _error = ex is ApiException api ? api.PrimaryError : "Could not reach the LedgerLite API. Make sure it is running.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OnPeriodChanged() => _ = InvokeAsync(async () =>
    {
        _accountsLoaded = false; // accounts are period-scoped
        await LoadBudgetsAsync();
    });

    private async Task ReevaluateAsync()
    {
        if (PeriodState.CurrentPeriod is null)
        {
            return;
        }

        _reevaluating = true;
        try
        {
            IReadOnlyList<BudgetEvaluationResponse> evaluations = await Api.EvaluateBudgetsAsync(PeriodState.CurrentPeriod.Id);
            _budgetRows = [.. _budgetRows.Select(row =>
                new BudgetRow(row.Budget, evaluations.FirstOrDefault(evaluation => evaluation.BudgetId == row.Budget.Id)))];

            int alerts = _budgetRows.Count(row => row.Evaluation?.ThresholdsExceeded.Count > 0);
            Toast.ShowInfo(alerts > 0
                ? $"{alerts} of {_budgetRows.Count} budgets exceeded a threshold."
                : $"All {_budgetRows.Count} budgets are within their limits.");
        }
        catch (ApiException ex)
        {
            Toast.ShowError(ex.PrimaryError);
        }
        catch (HttpRequestException)
        {
            Toast.ShowError("Could not reach the LedgerLite API. Make sure it is running.");
        }
        finally
        {
            _reevaluating = false;
        }
    }

    private async Task OpenCreateModalAsync()
    {
        _category = string.Empty;
        _limit = string.Empty;
        _categoryError = null;
        _limitError = null;

        if (!_accountsLoaded && PeriodState.CurrentPeriod is not null)
        {
            try
            {
                IReadOnlyList<AccountResponse> accounts = await Api.GetAccountsAsync(PeriodState.CurrentPeriod.Id);
                _expenseAccounts.Clear();
                _expenseAccounts.AddRange(accounts.Where(account => account.Type is AccountType.Expense));
                _accountsLoaded = true;
            }
            catch (ApiException ex)
            {
                Toast.ShowError(ex.PrimaryError);
                return;
            }
            catch (HttpRequestException)
            {
                Toast.ShowError("Could not reach the LedgerLite API. Make sure it is running.");
                return;
            }
        }

        _createOpen = true;
    }

    private async Task CreateAsync()
    {
        _categoryError = null;
        _limitError = null;

        if (string.IsNullOrWhiteSpace(_category))
        {
            _categoryError = "Pick an expense category.";
            return;
        }

        if (!decimal.TryParse(_limit, NumberStyles.Number, CultureInfo.InvariantCulture, out decimal limit) || limit <= 0)
        {
            _limitError = "Enter a positive amount, e.g. 500.00";
            return;
        }

        _creating = true;
        try
        {
            await Api.CreateBudgetAsync(new CreateBudgetRequest(
                PeriodId: PeriodState.CurrentPeriod!.Id,
                Category: _category,
                LimitAmount: limit,
                Currency: "USD"));

            Toast.ShowSuccess($"Budget of {Format.Money(limit)} set for {_category}.");
            _createOpen = false;
            await LoadBudgetsAsync();
        }
        catch (ApiException ex)
        {
            // 409: budget for this category already exists in the period.
            _categoryError = ex.PrimaryError;
        }
        catch (HttpRequestException)
        {
            Toast.ShowError("Could not reach the LedgerLite API. Make sure it is running.");
        }
        finally
        {
            _creating = false;
        }
    }

    private static BadgeTone ThresholdTone(BudgetThreshold threshold) => threshold switch
    {
        BudgetThreshold.HundredPercent => BadgeTone.Red,
        BudgetThreshold.EightyPercent => BadgeTone.Amber,
        _ => BadgeTone.Slate
    };

    private sealed record BudgetRow(BudgetResponse Budget, BudgetEvaluationResponse? Evaluation);

    public void Dispose() => PeriodState.Changed -= OnPeriodChanged;
}
