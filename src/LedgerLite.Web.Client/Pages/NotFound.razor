@page "/not-found"
@layout BlankLayout

<PageTitle>Not found · LedgerLite</PageTitle>

<div class="flex min-h-screen flex-col items-center justify-center gap-7 px-6 text-center">
    <p class="font-display text-8xl font-bold tnum text-transparent bg-gradient-to-b from-white via-slate-300 to-slate-600 bg-clip-text">
        404
    </p>
    <div>
        <h1 class="font-display text-xl font-semibold text-slate-200">This page doesn't balance</h1>
        <p class="mt-2 max-w-md text-sm leading-relaxed text-slate-500">
            The page you're looking for was moved, closed, or never existed.
            Check the URL — or head back to the ledger.
        </p>
    </div>
    <a href="/"
       class="inline-flex items-center gap-2 rounded-lg bg-accent-500 px-4 py-2 text-sm font-medium text-ink-950 shadow-lg shadow-accent-500/25 transition-all duration-150 outline-none hover:bg-accent-400">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m3 10 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
            <path d="M9 22V12h6v10" />
        </svg>
        Back to overview
    </a>
</div>
