<span class="@($"inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs font-medium {ToneClass}")">
    @ChildContent
</span>

@code {
    /// <summary>Color tone. Default <see cref="BadgeTone.Slate"/>.</summary>
    [Parameter] public BadgeTone Tone { get; set; } = BadgeTone.Slate;

    /// <summary>Badge content (text and/or dot).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string ToneClass => Tone switch
    {
        BadgeTone.Emerald => "border-accent-500/30 bg-accent-500/10 text-accent-300",
        BadgeTone.Amber => "border-warn-400/30 bg-warn-400/10 text-warn-400",
        BadgeTone.Red => "border-danger-400/30 bg-danger-400/10 text-danger-400",
        BadgeTone.Sky => "border-info-400/30 bg-info-400/10 text-info-400",
        BadgeTone.Violet => "border-violet-400/30 bg-violet-400/10 text-violet-300",
        _ => "border-white/10 bg-white/5 text-slate-400"
    };
}
