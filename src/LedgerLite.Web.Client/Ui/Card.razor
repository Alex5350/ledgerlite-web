<div class="@RootClass" style="@Style">
    @if (HasHeader)
    {
        <div class="@HeaderClass">
            <div class="min-w-0">
                @if (!string.IsNullOrWhiteSpace(Title))
                {
                    <h3 class="font-display text-sm font-semibold text-slate-100">@Title</h3>
                }
                @if (!string.IsNullOrWhiteSpace(Subtitle))
                {
                    <p class="mt-0.5 text-xs text-slate-500">@Subtitle</p>
                }
            </div>
            @if (ActionContent is not null)
            {
                <div class="shrink-0">@ActionContent</div>
            }
        </div>
    }
    @ChildContent
</div>

@code {
    /// <summary>Card heading.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Muted line under the title.</summary>
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>Optional action rendered on the right of the header (e.g. a button).</summary>
    [Parameter] public RenderFragment? ActionContent { get; set; }

    /// <summary>Card body.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Removes padding and puts the header in its own divider row (for tables).</summary>
    [Parameter] public bool Flush { get; set; }

    /// <summary>Extra classes appended to the root.</summary>
    [Parameter] public string Class { get; set; } = string.Empty;

    /// <summary>Inline style attributes (e.g. animation-delay for staggering).</summary>
    [Parameter] public string Style { get; set; } = string.Empty;

    private bool HasHeader =>
        !string.IsNullOrWhiteSpace(Title)
        || !string.IsNullOrWhiteSpace(Subtitle)
        || ActionContent is not null;

    private string RootClass => Flush
        ? $"card-surface overflow-hidden {Class}".TrimEnd()
        : $"card-surface p-5 {Class}".TrimEnd();

    private string HeaderClass => Flush
        ? "flex items-start justify-between gap-4 border-b border-white/[0.07] px-5 py-4"
        : "mb-4 flex items-start justify-between gap-4";
}
