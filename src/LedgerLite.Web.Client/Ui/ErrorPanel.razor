<div class="@($"rounded-card border border-danger-500/25 bg-danger-500/[0.07] p-5 {Class}")" role="alert">
    <div class="flex items-start gap-3">
        <svg class="mt-0.5 size-5 shrink-0 text-danger-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" />
            <path d="M12 9v4" />
            <path d="M12 17h.01" />
        </svg>
        <div class="min-w-0 flex-1">
            <p class="font-display text-sm font-semibold text-danger-400">@Title</p>
            <p class="mt-1 text-sm leading-relaxed text-slate-400">@Message</p>
            @if (Retry.HasDelegate)
            {
                <div class="mt-3">
                    <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Sm" OnClick="RetryAsync">Try again</Button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    /// <summary>Panel heading. Default "Something went wrong".</summary>
    [Parameter] public string Title { get; set; } = "Something went wrong";

    /// <summary>Human-readable failure detail (usually <c>ApiException.PrimaryError</c>).</summary>
    [Parameter, EditorRequired] public string Message { get; set; } = string.Empty;

    /// <summary>Optional retry callback — renders a "Try again" button.</summary>
    [Parameter] public EventCallback Retry { get; set; }

    /// <summary>Extra classes for the root.</summary>
    [Parameter] public string Class { get; set; } = string.Empty;

    private Task RetryAsync() => Retry.InvokeAsync();
}
