@* Deterministic loading indicator (stroke arc spinning around a dimmed track). *@
<svg class="@($"animate-spin {Class}")" viewBox="0 0 24 24" fill="none" role="status" aria-label="Loading">
    <circle class="opacity-20" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" />
    <path class="opacity-90" d="M12 2a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
</svg>

@code {
    /// <summary>Extra classes for the svg element (size/color), e.g. "size-4 text-accent-400".</summary>
    [Parameter] public string Class { get; set; } = "size-5";
}
