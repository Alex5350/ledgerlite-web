@namespace LedgerLite.Web.Client.Ui
@implements IDisposable
@inject IToastService ToastService

@if (_toasts.Count > 0)
{
    <div class="pointer-events-none fixed right-4 bottom-4 z-[90] flex w-[calc(100%-2rem)] max-w-sm flex-col gap-2" aria-live="polite">
        @foreach (ToastMessage toast in _toasts)
        {
            <div class="card-surface pointer-events-auto flex animate-rise items-start gap-3 p-4 @ToneBorder(toast.Tone)">
                <div class="@ToneText(toast.Tone) shrink-0">
                    @if (toast.Tone is ToastTone.Success)
                    {
                        <svg class="mt-0.5 size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M21.801 10A10 10 0 1 1 17 3.335" />
                            <path d="m9 11 3 3L22 4" />
                        </svg>
                    }
                    else if (toast.Tone is ToastTone.Error)
                    {
                        <svg class="mt-0.5 size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="10" />
                            <path d="M12 8v4" />
                            <path d="M12 16h.01" />
                        </svg>
                    }
                    else
                    {
                        <svg class="mt-0.5 size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="10" />
                            <path d="M12 16v-4" />
                            <path d="M12 8h.01" />
                        </svg>
                    }
                </div>
                <p class="flex-1 text-sm leading-relaxed text-slate-200">@toast.Message</p>
                <button type="button"
                        class="-m-1 rounded-lg p-1 text-slate-500 outline-none transition-colors hover:bg-white/5 hover:text-slate-200"
                        aria-label="Dismiss notification"
                        @onclick="() => ToastService.Dismiss(toast.Id)">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M18 6 6 18" />
                        <path d="m6 6 12 12" />
                    </svg>
                </button>
            </div>
        }
    </div>
}

@code {
    private IReadOnlyList<ToastMessage> _toasts = [];

    protected override void OnInitialized()
    {
        _toasts = ToastService.GetToasts();
        ToastService.Changed += OnToastsChanged;
    }

    private void OnToastsChanged() => _ = InvokeAsync(() =>
    {
        _toasts = ToastService.GetToasts();
        StateHasChanged();
    });

    private static string ToneBorder(ToastTone tone) => tone switch
    {
        ToastTone.Success => "border-accent-500/30",
        ToastTone.Error => "border-danger-400/30",
        _ => "border-info-400/30"
    };

    private static string ToneText(ToastTone tone) => tone switch
    {
        ToastTone.Success => "text-accent-400",
        ToastTone.Error => "text-danger-400",
        _ => "text-info-400"
    };

    public void Dispose() => ToastService.Changed -= OnToastsChanged;
}
