<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- xUnit1051 asks for TestContext.Current.CancellationToken, which does not compose
         with the HttpClient helpers used throughout these tests. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <!-- xunit.v3 test applications are executables driven by Microsoft.Testing.Platform. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LedgerLite.Api\LedgerLite.Api.csproj" />
  </ItemGroup>

</Project>
